# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# N8N_ANALYZE_WEBHOOK: The external webhook URL for n8n source prompt analysis logic.
N8N_ANALYZE_WEBHOOK=

# JWT_SECRET: Secret key used to sign JWT tokens for session cookies.
JWT_SECRET=

# GOOGLE_CLIENT_ID: OAuth 2.0 client ID for Google Login.
GOOGLE_CLIENT_ID=

# MeliPayamak SMS Gateway Credentials
MELIPAYAMAK_USERNAME="your_username"
MELIPAYAMAK_PASSWORD="your_password"
MELIPAYAMAK_OTP_BODY_ID="123456"

# Bootstrap administrator: roles thereafter come only from persisted user records.
SUPER_ADMIN_PHONE="09123456789"
SUPER_ADMIN_EMAIL=
ADMIN_EMAIL=
ADMIN_PASSWORD=



# Production launch requirements (never use LOCAL_PREVIEW on a public deployment)
APP_ORIGIN=https://promty.ir
HOST=127.0.0.1
PORT=3005
# Mount both paths on durable private storage shared by processes on one host.
OTP_STORE_PATH=.private/otp-store.json
SECURITY_STATE_PATH=.private/security-state.json
AI_DAILY_REQUEST_LIMIT=100

# Primary storage: PostgreSQL (secret URL belongs in the private .env only).
DATABASE_URL=
# Legacy compatibility only, never silently enable it to hide a PostgreSQL error:
# STORAGE_BACKEND=json
